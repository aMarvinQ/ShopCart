# Copia este archivo como .env y completa los valores. .env nunca se versiona.

# Entorno: development | test | production
NODE_ENV=development
PUERTO=3000
LOG_NIVEL=info

# SQL Server. La API se conecta SOLO como shopcart_api (únicamente puede ejecutar SPs).
DB_SERVIDOR=localhost
DB_PUERTO=14330
DB_NOMBRE=ShopCart
# Base de las pruebas de la API (npm test). Se crea con: .\deploy.ps1 -Bootstrap -BaseDatos ShopCart_Pruebas
DB_NOMBRE_PRUEBAS=ShopCart_Pruebas
DB_USUARIO=shopcart_api
DB_CONTRASENA=
# true solo en desarrollo local (certificado autofirmado de SQL Server)
DB_CONFIAR_CERTIFICADO=true

# Secreto para firmar los JWT: mínimo 32 caracteres aleatorios.
# Generar: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=
JWT_ACCESO_MINUTOS=15

# Orígenes del frontend permitidos por CORS, separados por coma
CORS_ORIGENES=http://localhost:5173

# Carpeta de las imágenes subidas (fuera de Git)
CARPETA_UPLOADS=uploads

# Documentación interactiva (Swagger) en /api/v1/docs
DOCS_ACTIVAS=true
