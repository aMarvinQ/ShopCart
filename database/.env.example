# Copia este archivo como .env (no se versiona) y define las contraseñas.
# Requisitos: mínimo 12 caracteres, cumplir la política de contraseñas de Windows
# (mayúsculas, minúsculas, números y símbolos) y no usar comillas simples (').

# Servidor SQL Server: host,puerto o host\instancia
SQL_SERVER=localhost,14330

# Login con permisos de dueño solo sobre la base ShopCart (crea tablas, SPs, vistas y funciones)
SHOPCART_MIGRATOR_PASSWORD=

# Login que usa la API: solo puede ejecutar stored procedures
SHOPCART_API_PASSWORD=
